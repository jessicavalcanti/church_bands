<Layouts.app flash={@flash} current_user={@current_user}>
  <%= if @current_user do %>
    <.header>
      Olá, {@current_user.name}
      <:subtitle>
        Você está no sistema como {Layouts.role_label(@current_user.global_role)}.
      </:subtitle>
    </.header>

    <div :if={ChurchBands.Accounts.full_access?(@current_user)} class="pt-2">
      <.button id="home-invites-button" navigate={~p"/admin/invites"} variant="primary">
        <.icon name="hero-envelope" /> Gerenciar convites
      </.button>
    </div>
  <% else %>
    <.header class="text-center">
      Grupo de Louvor
      <:subtitle>
        Organização das bandas, dos músicos e do repertório da igreja.
      </:subtitle>
    </.header>

    <div class="text-center pt-2">
      <.button id="home-login-button" navigate={~p"/login"} variant="primary">Entrar</.button>
    </div>
  <% end %>
</Layouts.app>

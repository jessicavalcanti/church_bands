<%= if @current_user do %>
  <Layouts.app
    flash={@flash}
    current_user={@current_user}
    current_path={~p"/"}
    sidebar_state={@sidebar_state}
    unread={@unread_notifications}
  >
    <:actions>
      <.link
        :if={ChurchBands.Accounts.full_access?(@current_user)}
        id="home-invites-button"
        navigate={~p"/admin/invites"}
        class={button_variant(%{size: "sm"})}
      >
        <.icon name="hero-envelope" class="mr-2 size-4" /> Gerenciar convites
      </.link>
    </:actions>

    <.header>
      Olá, {@current_user.name}
      <:subtitle>
        Você está no sistema como {ChurchBands.Accounts.User.role_label(@current_user.global_role)}.
      </:subtitle>
    </.header>

    <%!-- O que espera resposta vem **antes** do que é só informação: a home é
          lida de cima para baixo, e um pedido de troca parado é a única coisa
          nesta tela em que alguém está esperando por você (US 4.6).

          **Este bloco não tem estado vazio: ele não aparece.** É a diferença
          entre ele e *Meus próximos eventos*, logo abaixo — ali o vazio é
          resposta, e aqui um "nenhuma troca pendente" permanente seria ruído
          na tela de todo mundo, todo dia, para dizer que nada aconteceu. --%>
    <div :if={pending_swaps?(@pending_swaps)} class="mt-8">
      <.header>
        Trocas pendentes
        <:subtitle>
          O que ainda espera resposta. Responder é em Trocas — aqui a home só mostra e encaminha.
        </:subtitle>
      </.header>

      <ul id="pending-swaps" class="divide-border mt-3 divide-y text-sm">
        <%!-- Os recebidos primeiro, e com botão: são ação sua. --%>
        <li
          :for={request <- @pending_swaps.received}
          id={"pending-swap-#{request.id}"}
          class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 py-3"
        >
          <div class="space-y-1">
            <p class="font-medium">
              {request.requester_member.user.name} · {BandMember.role_label(
                request.requester_member
              )}
            </p>
            <.slot_line
              id={"pending-swap-origin-#{request.id}"}
              label="Ele(a) não pode:"
              event_band={request.requester_event_band}
            />
            <.slot_line
              id={"pending-swap-target-#{request.id}"}
              label="O seu dia:"
              event_band={request.target_event_band}
            />
          </div>

          <.link
            id={"pending-swap-respond-#{request.id}"}
            navigate={~p"/swaps"}
            class={button_variant(%{variant: "outline", size: "sm"})}
          >
            Responder
          </.link>
        </li>

        <%!-- Os enviados depois, e sem botão: não são ação sua, são espera. --%>
        <li :for={request <- @pending_swaps.sent} id={"pending-swap-#{request.id}"} class="py-3">
          <div class="space-y-1">
            <p class="text-muted-foreground">
              Esperando resposta de
              <span class="text-foreground font-medium">
                {request.target_member.user.name}
              </span>
              · {BandMember.role_label(request.requester_member)}
            </p>
            <.slot_line
              id={"pending-swap-origin-#{request.id}"}
              label="Você não pode:"
              event_band={request.requester_event_band}
            />
            <.slot_line
              id={"pending-swap-target-#{request.id}"}
              label="O dia dele(a):"
              event_band={request.target_event_band}
            />
          </div>
        </li>
      </ul>
    </div>

    <div class="mt-8">
      <.header>
        Meus próximos eventos
        <:subtitle>
          Onde você precisa estar nos próximos {Schedule.upcoming_days()} dias.
        </:subtitle>
      </.header>

      <ul
        :if={@upcoming_events != []}
        id="upcoming-events"
        class="divide-border mt-3 divide-y text-sm"
      >
        <li :for={event <- @upcoming_events}>
          <.link
            id={"upcoming-event-#{event.id}"}
            navigate={~p"/events/#{event.id}"}
            class="hover:bg-muted -mx-2 flex flex-wrap gap-x-3 gap-y-1 rounded-md px-2 py-3"
          >
            <span class="text-muted-foreground w-40 shrink-0">
              {LocalTime.format(event.starts_at, :short)}
            </span>
            <%!-- O resto da linha é uma coluna só para os nomes das bandas
                  caírem alinhados com o título, e não com a data. --%>
            <div class="flex min-w-0 flex-1 flex-col gap-1">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <.badge variant="outline">{event.event_type.name}</.badge>

                <span class={["font-medium", event.status == :cancelled && "line-through"]}>
                  {event.title}
                </span>

                <span :if={event.location} class="text-muted-foreground">
                  {event.location}
                </span>

                <.badge
                  :if={event.status == :cancelled}
                  id={"upcoming-event-cancelled-#{event.id}"}
                  variant="secondary"
                >
                  Cancelado
                </.badge>

                <%!-- A marca da troca (US 4.4). *Provisório* é a mesma palavra
                      do elenco do evento, e o dia cedido continua na lista:
                      linha que some não avisa ninguém de que mudou. --%>
                <.badge
                  :if={match?({:assumed, _titular}, event.swap)}
                  id={"upcoming-event-provisional-#{event.id}"}
                  variant="outline"
                >
                  Provisório
                </.badge>
              </div>

              <span
                :if={event.swap}
                id={"upcoming-event-swap-#{event.id}"}
                class="text-muted-foreground text-xs"
              >
                {swap_note(event.swap)}
              </span>

              <span
                :if={event.event_bands != []}
                id={"upcoming-event-bands-#{event.id}"}
                class="text-muted-foreground"
              >
                {band_names(event.event_bands)}
              </span>
            </div>
          </.link>
        </li>
      </ul>

      <p
        :if={@upcoming_events == []}
        id="upcoming-events-empty"
        class="text-muted-foreground mt-3 text-sm"
      >
        Nenhum evento seu nos próximos {Schedule.upcoming_days()} dias.
        <.link
          id="upcoming-events-calendar-link"
          navigate={~p"/calendar"}
          class="text-foreground underline underline-offset-4"
        >
          Ver calendário
        </.link>
      </p>
    </div>

    <%!-- O resumo, e não a lista: cinco linhas e um caminho para a central.
          Sem notificação nenhuma o bloco **não aparece**, pelo mesmo motivo do
          de trocas — um "nada por aqui" fixo na home não é resposta a pergunta
          nenhuma (US 4.6). --%>
    <div :if={@recent_notifications != []} class="mt-8">
      <.header>
        Últimas notificações
        <:subtitle>O que aconteceu com você, das mais recentes para as mais antigas.</:subtitle>
      </.header>

      <ul id="recent-notifications" class="divide-border mt-3 divide-y text-sm">
        <li :for={notification <- @recent_notifications}>
          <%!-- É um `POST`, e não um link comum: abrir uma notificação
                **escreve** — ela fica lida — e só depois leva ao caminho dela.
                Quem faz as duas coisas é
                `ChurchBandsWeb.NotificationController`, porque a home não tem
                socket para um `phx-click` como a central tem. --%>
          <.link
            id={"recent-notification-#{notification.id}"}
            href={~p"/notifications/#{notification.id}/open"}
            method="post"
            class="hover:bg-muted -mx-2 flex items-start gap-3 rounded-md px-2 py-3"
          >
            <.notification_line notification={notification} />
          </.link>
        </li>
      </ul>

      <p class="mt-3 text-sm">
        <.link
          id="recent-notifications-all"
          navigate={~p"/notifications"}
          class="text-foreground underline underline-offset-4"
        >
          Ver todas
        </.link>
      </p>
    </div>
  </Layouts.app>
<% else %>
  <Layouts.public flash={@flash}>
    <.header class="text-center">
      Grupo de Louvor
      <:subtitle>
        Organização das bandas, dos músicos e do repertório da igreja.
      </:subtitle>
    </.header>

    <div class="pt-2 text-center">
      <.link id="home-login-button" navigate={~p"/login"} class={button_variant(%{})}>
        Entrar
      </.link>
    </div>
  </Layouts.public>
<% end %>

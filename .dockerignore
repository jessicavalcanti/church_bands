# Artefatos de build da máquina host: foram compilados com outra versão de
# Erlang/Elixir e não podem vazar para dentro da imagem.
_build/
deps/
cover/
doc/
.fetch
erl_crash.dump
*.ez

# Assets gerados e dependências de node
priv/static/assets/
priv/static/cache_manifest.json
assets/node_modules/

# Nada disso é necessário para construir a imagem.
# `.git` vai sem barra: num `git worktree` ele é um arquivo apontando para o
# gitdir do repositório principal, e `.git/` só casaria com o diretório.
.git
.gitignore
.dockerignore
Dockerfile.dev
docker-compose.yml
*.md
!README.md

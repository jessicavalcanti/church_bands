# Imagem de desenvolvimento: o código é montado como volume pelo compose, então
# aqui só preparamos o toolchain e as dependências.
# A versão precisa acompanhar a usada em desenvolvimento: o config/runtime.exs
# gerado pelo Phoenix 1.8 usa o modificador de regex ~r"..."E, que só existe a
# partir do Elixir 1.20.
FROM hexpm/elixir:1.20.3-erlang-29.0.5-debian-bookworm-20260803-slim

# `MIX_ENV` fica deliberadamente sem valor: o padrão do Mix já é `dev`, e fixá-lo
# na imagem impedia o `preferred_envs` do mix.exs de agir — `mix precommit`
# rodava a suíte em `dev` e estourava no sandbox do Ecto.
ENV LANG=C.UTF-8

RUN apt-get update -y \
    && apt-get install -y build-essential git inotify-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /app

# Copiamos só os manifestos primeiro para aproveitar o cache de camadas do
# Docker: as dependências só são refetchadas quando mix.exs/mix.lock mudam.
COPY mix.exs mix.lock ./
RUN mix deps.get

COPY . .
RUN mix deps.compile

EXPOSE 4000

CMD ["mix", "phx.server"]
